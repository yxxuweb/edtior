{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@lowcode/core": [
                "../../packages/core/src/index.ts"
            ],
            "@lowcode/renderer-react": [
                "../../packages/renderer-react/src/index.ts"
            ],
            "@lowcode/utils-logger": [
                "../../packages/utils-logger/src/index.ts"
            ]
        }
    },
    "include": [
        "src"
    ]
}